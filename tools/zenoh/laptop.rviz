Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.3
    # ★ Durability=Volatile — cartographer_occupancy_grid_node 의 /map 은
    #   volatile 이다. RViz 기본(Transient Local)으로 두면 QoS 불일치로
    #   맵이 아예 안 보이는데 에러도 눈에 잘 안 띈다.
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Trajectory
      Enabled: false
      Topic:
        Value: /trajectory_node_list
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Constraints
      Enabled: false
      Topic:
        Value: /constraint_list
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Centerline
      Enabled: true
      Topic:
        Value: /hmpc/centerline
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /obstacle/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Opponent corridor
      Enabled: true
      Topic:
        Value: /hmpc/opponent_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: tracked_pose
      Enabled: true
      Topic:
        Value: /tracked_pose
      Shape: Arrow
      Color: 255; 0; 255
      Shaft Length: 0.3
      Head Length: 0.1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: false
        base_link:
          Value: true
        laser:
          Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.07
      Topic:
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Height: 900
  Width: 1400
