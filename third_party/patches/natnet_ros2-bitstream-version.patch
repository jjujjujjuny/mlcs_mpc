diff --git a/src/natnet_ros2.cpp b/src/natnet_ros2.cpp
index c8be4a4..e5f9db3 100644
--- a/src/natnet_ros2.cpp
+++ b/src/natnet_ros2.cpp
@@ -25,6 +25,8 @@ using CallbackReturnT =
 NatNetNode::NatNetNode(rclcpp::NodeOptions& node_options) : LifecycleNode("natnet_ros2_node")
 {
     //declare_parameter<std::string>("node_name", "");
+    // ★ Motive 2.x (NatNet 3.x) 대응 — 아래 set_conn_params() 주석 참고
+    declare_parameter<std::string>("bitstream_version", "3.1.0.0");
     declare_parameter<bool>("log_internals", false);
     declare_parameter<bool>("log_frames", false);
     declare_parameter<bool>("log_latencies", false);
@@ -180,6 +182,45 @@ void NatNetNode::set_conn_params()
     g_connectParams.serverAddress = serverIP.c_str();
     g_connectParams.localAddress = clientIP.c_str();
     g_connectParams.multicastAddress = serverType=="multicast" ? multicastAddress.c_str() : NULL;
+
+    // ── ★ 구버전 Motive 대응 (2026-09-18, 로컬 패치) ──────────────────────
+    //
+    //   Motive 2.3.0.1 은 NatNet **3.1** 로 말한다. 그런데 이 드라이버가 쓰는
+    //   NatNet SDK 4.4 는 BitstreamVersion 을 비워두면 4.x 응답을 기대하고,
+    //   3.1 서버의 짧은 응답을 파싱하지 못해 **assert 로 죽는다**:
+    //
+    //       ClientCore.cpp:710: ValidateHostConnection():
+    //           Assertion `mServerDescription.HostPresent' failed.   (SIGABRT)
+    //
+    //   Motive 는 정상 응답하고 있었다 — 같은 젯슨에서 SDK 동봉 파이썬
+    //   클라이언트로 확인했다. 그쪽은 스스로 "resetting requested version to
+    //   3 1 0 0" 하고 100Hz 로 프레임을 잘 받는다. C++ SDK 만 협상을 안 한다.
+    //
+    //   그래서 원하는 비트스트림 버전을 명시적으로 알려준다.
+    //     "3.1.0.0"  Motive 2.x            ← 현재 장비
+    //     "4.0.0.0"  Motive 3.x
+    //     ""         지정 안 함 (SDK 기본). Motive 2.x 에서는 위 assert 로 죽는다.
+    {
+        std::string bsv;
+        get_parameter("bitstream_version", bsv);
+        memset(g_connectParams.BitstreamVersion, 0,
+               sizeof(g_connectParams.BitstreamVersion));
+        if (!bsv.empty())
+        {
+            int v[4] = {0, 0, 0, 0};
+            if (sscanf(bsv.c_str(), "%d.%d.%d.%d", &v[0], &v[1], &v[2], &v[3]) >= 2)
+            {
+                for (int i = 0; i < 4; ++i)
+                    g_connectParams.BitstreamVersion[i] = (uint8_t)v[i];
+                RCLCPP_INFO(get_logger(), "Requesting NatNet bitstream version %d.%d.%d.%d",
+                            v[0], v[1], v[2], v[3]);
+            }
+            else
+                RCLCPP_WARN(get_logger(),
+                            "bitstream_version '%s' 파싱 실패 — 지정하지 않고 진행합니다",
+                            bsv.c_str());
+        }
+    }
 }
 
 
