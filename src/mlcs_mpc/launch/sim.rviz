Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 70; 70; 75
      Line Style:
        Line Width: 0.01
        Value: Lines
    - Class: rviz_default_plugins/MarkerArray
      Name: Track
      Enabled: true
      Topic:
        Value: /sim/markers
        Durability Policy: Transient Local
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: Car
      Enabled: true
      Topic:
        Value: /sim/car
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: Predicted
      Enabled: true
      Topic:
        Value: /sim/predicted
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: Trail
      Enabled: true
      Topic:
        Value: /sim/trail
      Namespaces: {}
    - Class: rviz_default_plugins/Marker
      Name: Text
      Enabled: true
      Topic:
        Value: /sim/text
      Namespaces: {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Opponent
      Enabled: true
      Topic:
        Value: /mpcc/opponent_markers
      Namespaces: {}
    - Class: rviz_default_plugins/Odometry
      Name: State
      Enabled: false
      Topic:
        Value: /mpc/state
      Keep: 1
      Shape:
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: map
      Scale: 120
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Height: 900
  Width: 1400
