Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    # 1 m 격자 — 벽까지 거리를 눈으로 잴 수 있게
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: laser
      Cell Size: 1
      Plane Cell Count: 24
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/Axes
      Name: Laser
      Enabled: true
      Reference Frame: laser
      Length: 0.3
      Radius: 0.02
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # ★ laser 기준 — 브링업(TF) 없이 라이다만 띄워도 보인다
    Fixed Frame: laser
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Height: 800
  Width: 1200
